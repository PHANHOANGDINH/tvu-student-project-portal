# Copy this file to .env before running Docker Compose.
# Replace every placeholder with a local development value. Never commit .env.

MSSQL_SA_PASSWORD=replace-with-a-strong-local-password
DB_DATABASE=tvu_student_project_portal
SQL_SERVER_PORT=1433

JWT_SECRET=replace-with-a-long-random-local-secret
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=10

# Optional local-only admin seed. Leave both blank to skip.
DOCKER_SEED_ADMIN_EMAIL=
DOCKER_SEED_ADMIN_PASSWORD=

FRONTEND_PORT=8080
BACKEND_PORT=5000
CORS_ALLOWED_ORIGINS=http://localhost:8080
