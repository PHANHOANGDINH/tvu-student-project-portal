# Copy this file to .env before running Docker Compose.
# Replace every placeholder with a local development value. Never commit .env.

MSSQL_SA_PASSWORD=replace-with-a-strong-local-password
DB_DATABASE=tvu_student_project_portal
SQL_SERVER_PORT=1433

JWT_SECRET=replace-with-a-long-random-local-secret
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=10

# Optional local-only admin seed. Leave both blank to skip.
DOCKER_SEED_ADMIN_EMAIL=
DOCKER_SEED_ADMIN_PASSWORD=

FRONTEND_PORT=8080
BACKEND_PORT=5000
CORS_ALLOWED_ORIGINS=http://localhost:8080

# RabbitMQ local credentials. Replace both values before starting Compose.
RABBITMQ_USER=replace-with-a-local-rabbitmq-user
RABBITMQ_PASSWORD=replace-with-a-strong-local-rabbitmq-password
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_PREFETCH=10
RABBITMQ_MAX_RETRIES=3
RABBITMQ_RETRY_DELAY_MS=5000
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_MAX_ATTEMPTS=20
