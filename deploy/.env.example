# Copy to the repository root as .env.production and chmod 600.
COMPOSE_PROJECT_NAME=tvu-student-project-portal-prod
DOMAIN=portal.example.edu.vn
LETSENCRYPT_EMAIL=admin@example.edu.vn
MSSQL_PID=Express
MSSQL_SA_PASSWORD=replace-with-a-strong-production-password
DB_DATABASE=tvu_student_project_portal
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=12
RABBITMQ_USER=replace-with-a-production-rabbitmq-user
RABBITMQ_PASSWORD=replace-with-a-strong-production-rabbitmq-password
RABBITMQ_VHOST=/
DOCKER_SEED_ADMIN_EMAIL=
DOCKER_SEED_ADMIN_PASSWORD=
CLIENT_MAX_BODY_SIZE=25m
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
BACKUP_ROOT=deploy/backups
BACKUP_RETENTION_DAYS=14
BACKUP_WEEKLY_RETENTION_WEEKS=8
OFFSITE_BACKUP_COMMAND=
ALLOW_DEPLOY_WITHOUT_BACKUP=false
BACKEND_IMAGE=tvu-student-project-portal-backend:latest
FRONTEND_IMAGE=tvu-student-project-portal-frontend:latest
DEPLOY_REF=v1.1.0
