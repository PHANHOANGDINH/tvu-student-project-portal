# Copy to .env.production on the VPS and replace every placeholder.
# Never commit .env.production.

COMPOSE_PROJECT_NAME=tvu-student-project-portal-prod
DOMAIN=portal.example.edu.vn
LETSENCRYPT_EMAIL=admin@example.edu.vn

MSSQL_PID=Developer
MSSQL_SA_PASSWORD=replace-with-a-strong-production-password
DB_DATABASE=tvu_student_project_portal

JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=12

RABBITMQ_USER=replace-with-a-production-rabbitmq-user
RABBITMQ_PASSWORD=replace-with-a-strong-production-rabbitmq-password
RABBITMQ_VHOST=/
RABBITMQ_PREFETCH=10
RABBITMQ_MAX_RETRIES=3
RABBITMQ_RETRY_DELAY_MS=5000
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_MAX_ATTEMPTS=20

# Leave blank in production unless intentionally creating the first admin.
DOCKER_SEED_ADMIN_EMAIL=
DOCKER_SEED_ADMIN_PASSWORD=

CLIENT_MAX_BODY_SIZE=25m
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Optional registry images. Defaults build local images when omitted.
BACKEND_IMAGE=tvu-student-project-portal-backend:latest
FRONTEND_IMAGE=tvu-student-project-portal-frontend:latest

# Git ref fetched and deployed by deploy/scripts/deploy.sh.
DEPLOY_REF=origin/main
